# ── CSRD Comply — Environment Variables Example ─────────────────
# Copia questo file in .env per lo sviluppo locale:
#   cp .env.example .env
# Poi inserisci i tuoi valori (API key, secret, etc.)
#
# 🔴 NON versionare MAI .env con credenziali reali!
# In produzione usa variabili d'ambiente via docker-compose, k8s o secret manager.
#
# ⚠️ REQUIRED: Database e JWT Secret devono sempre essere impostati.
#    In produzione anche SENTRY_DSN è obbligatorio.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csrd_comply

# Auth / JWT
# Genera una SECRET_KEY sicura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI / LLM — Richiedi le chiavi API al team
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Supabase (opzionale)
SUPABASE_URL=
SUPABASE_KEY=

# Multitenancy
ENABLE_MULTITENANCY=false
DEFAULT_SCHEMA=public

# Deployment
DEPLOYMENT_DOMAIN=csrdcomply.com
DEPLOYMENT_SSL_ENABLED=true

# Request limits
MAX_REQUEST_SIZE_MB=10

# Monitoring (Sentry) — REQUIRED in produzione
# SENTRY_DSN=https://xxx@xxxxx.ingest.sentry.io/xxxxxx
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Email — SMTP / SendGrid / Mailgun ──────────────────────────
# Per sviluppo: usa SMTP locale o lascia vuoto (le email vengono loggate)
EMAIL_FROM=noreply@csrdcomply.com
EMAIL_FROM_NAME=CSRD Comply
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# In alternativa, usa SendGrid:
SENDGRID_API_KEY=
# Oppure Mailgun:
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── Stripe — Attivazione pagamenti entro 3 mesi ────────────────
# sk_live_xxx o sk_test_xxx
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
